menuconfig TLK_MTIMER
    bool "MTIMER"


if TLK_MTIMER

menuconfig TLK_MTIMER_IRQ
    bool "Enable interrupts"


if TLK_MTIMER_IRQ

config TLK_MTIMER_IRQ_USE_NEST
    bool
    default n


config TLK_MTIMER_IRQ_NEST_PLIC_SW
    bool "Nest machine software interrupt (MSIE)"
    select TLK_MTIMER_IRQ_USE_NEST
    depends on TLK_PLIC_SW


config TLK_MTIMER_IRQ_NEST_PLIC
    bool "Nest external interrupts (MEIE)"
    select TLK_MTIMER_IRQ_USE_NEST
    depends on TLK_PLIC

endif # TLK_MTIMER_IRQ

endif # TLK_MTIMER