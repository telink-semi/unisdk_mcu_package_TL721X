    prompt "RX mode"
    default TLK_UART1_RX_IRQ

config TLK_UART1_RX_IRQ
    bool "Interrupt"
    select TLK_UART1_USE_IRQ

config TLK_UART1_RX_DMA
    bool "DMA"
    select TLK_UART1_USE_DMA
