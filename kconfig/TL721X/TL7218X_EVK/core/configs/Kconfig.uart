config TLK_UART1_AC_FLOW_CONTROL_NONE
    bool "None"

config TLK_UART1_AC_FLOW_CONTROL_RTS
    bool "RTS"

config TLK_UART1_FLOW_CONTROL_CTS
    bool "CTS"

