config TLK_UART1_AC_FLOW_POLARITY
    string
    default "TLK_UART_ACTIVE_LOW" if TLK_UART1_AC_FLOW_POLARITY_LOW
    default "TLK_UART_ACTIVE_HIGH" if TLK_UART1_AC_FLOW_POLARITY_HIGH

endif # TLK_UART1_FLOW_CONTROL

endif # UART1_AUTO_CONFIG


choice
    prompt "TX mode"
    default TLK_UART1_TX_BLOCKING

config TLK_UART1_TX_BLOCKING
    bool "Blocking"
    select TLK_UART_USE_BLOCKING

config TLK_UART1_TX_IRQ
    bool "Interrupt"
    select TLK_UART1_USE_IRQ
    depends on TLK_PLIC

config TLK_UART1_TX_DMA
    bool "DMA"
    select TLK_UART1_USE_DMA
    select TLK_UART1_USE_IRQ
    depends on TLK_DMA
    depends on TLK_PLIC

endchoice # TX mode


config TLK_UART1_TX_MODE
    string
    default "TLK_UART_XFER_BLOCKING" if TLK_UART1_TX_BLOCKING
    default "TLK_UART_XFER_IRQ" if TLK_UART1_TX_IRQ
    default "TLK_UART_XFER_DMA" if TLK_UART1_TX_DMA


